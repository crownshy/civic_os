# Copy this file to `.env` and you're done:
#   cp .env.example .env

# Where to forward /api/* requests. Local backend by default.
# Point at staging if you don't want to run the backend:
#   API_URL=https://bloom.comhairle.scot
#   API_PREFIX=/api
API_URL=http://localhost:3000

# Run `./scripts/seed-dev.sh` from the repo root to create a Campaign against
# your local backend. It puts the Campaign in Dundee, listed at
# http://localhost:5173/dundee and on the directory at http://localhost:5173/.
