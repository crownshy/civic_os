# Copy this file to `.env` and you're done:
#   cp .env.example .env

# Where to forward /api/* requests. Local backend by default.
# Point at staging if you don't want to run the backend:
#   API_URL=https://bloom.comhairle.scot
#   API_PREFIX=/api
API_URL=http://localhost:3000

# --- Which Campaign the site root redirects to ---
# Participant URLs are /<org>/conversations/<conversation-slug>, so the Campaign
# comes off the path. This only says where bare `/` sends someone. Unset sends
# `/` to the directory of live conversations (ADR 0011).
# PUBLIC_CAMPAIGN_SLUG=

# Run `./scripts/seed-dev.sh` from the repo root to create a Campaign against
# your local backend. It sets the above and puts the Campaign in Dundee, listed
# at http://localhost:5173/dundee.
