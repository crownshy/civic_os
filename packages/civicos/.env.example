# Copy this file to `.env` and you're done:
#   cp .env.example .env

# Where to forward /api/* requests. Local backend by default.
# Point at staging if you don't want to run the backend:
#   API_URL=https://bloom.comhairle.scot
#   API_PREFIX=/api
API_URL=http://localhost:3000

# --- Which Campaign the Place root redirects to ---
# Participant URLs are <place>.bloomproject.us/<campaign-slug>, so the Campaign
# comes off the path. This only says where bare `/` sends someone. It has to be
# configured because a Place is not a record yet and nothing can list the
# Campaigns in one (see docs/adr/0006). Unset falls back to the region slug.
# PUBLIC_CAMPAIGN_SLUG=

# Run `./scripts/seed-dev.sh` from the repo root to create a Campaign against
# your local backend. It sets the above and puts the Campaign in Dundee,
# reachable at http://dundee.localhost:5173.
