# Copy this file to `.env` and you're done:
#   cp .env.example .env

# Where to forward /api/* requests. Local backend by default.
# Point at staging if you don't want to run the backend:
#   API_URL=https://bloom.comhairle.scot
#   API_PREFIX=/api
API_URL=http://localhost:3000

# --- Participant site ---
# Apex the participant app is served from, without a scheme. Admin builds each
# Campaign's share link as `<place>.<this>/<campaign-slug>` (ADR 0007). Unset
# means no share links are rendered, rather than broken ones.
#   PUBLIC_PARTICIPANT_BASE_URL=bloomproject.us
PUBLIC_PARTICIPANT_BASE_URL=localhost:5173

# Run `./scripts/seed-dev.sh` from the repo root to create a Campaign against
# your local backend. The sidebar lists it from `GetPermittedConversations`, so
# nothing needs pinning here.
