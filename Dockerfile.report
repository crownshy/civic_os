# ---- Base Stage ----
FROM node:22 AS base
WORKDIR /app

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Copy workspace manifests and every package manifest first so the install
# layer is cacheable and pnpm can resolve the workspace graph.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/civicos/package.json ./packages/civicos/
COPY packages/admin/package.json ./packages/admin/
COPY packages/report/package.json ./packages/report/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile

# ---- Build Stage ----
FROM base AS build
ENV NODE_OPTIONS="--max-old-space-size=4096"
WORKDIR /app

# Copy the rest of the source
COPY . .

# Build only the report SvelteKit app (skip civicos/admin/shared)
RUN pnpm --filter @civicos/report build

# Produce a self-contained deployable. The report has no workspace dependencies,
# but `deploy` still gives us a prod-only node_modules in one directory.
RUN pnpm --filter @civicos/report deploy --prod /prod/report

# pnpm deploy honors the package's .gitignore if one exists. The report package
# has none today, but copy the SvelteKit build output in explicitly so a future
# .gitignore can't silently drop it from the prod image.
RUN rm -rf /prod/report/build && cp -r packages/report/build /prod/report/build

# ---- Production Stage ----
FROM node:22-slim AS production
ENV NODE_OPTIONS="--max-old-space-size=4096"
WORKDIR /app

COPY --from=build /prod/report ./

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "build/index.js"]
