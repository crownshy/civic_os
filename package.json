{
	"name": "civic-os-workspace",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter civic-os dev",
		"dev:admin": "pnpm --filter @civicos/admin dev",
		"dev:report": "pnpm --filter @civicos/report dev",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "pnpm --filter civic-os --filter @civicos/admin --filter @civicos/report lint",
		"format": "pnpm --filter civic-os --filter @civicos/admin --filter @civicos/report format",
		"test": "pnpm --filter civic-os --filter @civicos/admin --filter @civicos/report exec vitest run",
		"prototype:places": "node --experimental-strip-types --no-warnings prototypes/campaign-places/tui.ts"
	}
}
